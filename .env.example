PORT=4300
# Wave AI (OpenAI-compatible). Leave blank => Wave shows "Connect AI", never fake replies.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
WAVE_MODEL=gpt-4o-mini
WAVE_TTS_MODEL=gpt-4o-mini-tts
WAVE_VOICE=shimmer
# Slack: dry-run (logged to Settings > Slack log) unless ALL are set + Owner enables Slack in Settings
SLACK_LIVE=false
SLACK_WEBHOOK_URL=
SLACK_BOT_TOKEN=
# Set false to start with an empty DB (no [TEST] data)
SEED_TEST_DATA=true
